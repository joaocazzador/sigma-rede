+class LocalCodeSim:
+    def __init__(self):
+        self.active, self.workspace, self.tasks, self.counter = False, "", {}, 0
+
+    def snapshot(self):
+        tasks = {}
+        pending = []
+        for task_id, entry in self.tasks.items():
+            task = {k: entry[k] for k in ("description", "action", "path", "status", "approved", "validated",
+                                           "steps_done", "risk", "requires_approval", "steps", "result")
+                    if k in entry}
+            tasks[task_id] = task
+            if entry["status"] == "awaiting_approval":
+                pending.append(task_id)
+        completed = sum(task["status"] == "completed" for task in tasks.values())
+        return {"session_id": "local-test", "pending_approvals": pending, "tasks": tasks,
+                "total_tasks": len(tasks), "completed_tasks": completed,
+                "summary": {"pending_approvals": len(pending), "completed": completed, "total": len(tasks)}}
+
+    def state(self):
+        return {"active": self.active, "workspace": self.workspace,
+                "session": self.snapshot() if self.active else None}
+
+    def start(self, body):
+        self.active, self.workspace, self.tasks, self.counter = True, str(body.get("folder") or ""), {}, 0
+        return self.state()
+
+    def create(self, description, action, path, content=""):
+        self.counter += 1
+        task_id = f"local-{self.counter}"
+        write = action == "write"
+        steps = ([{"action": "review_scope", "requires_approval": False},
+                  {"action": "preview", "requires_approval": False},
+                  {"action": "write", "requires_approval": True}] if write else
+                 [{"action": "inspect", "requires_approval": False},
+                  {"action": action, "requires_approval": False}])
+        self.tasks[task_id] = {"description": description, "action": action, "path": path,
+                               "status": "queued", "approved": False, "validated": False,
+                               "steps_done": 0, "risk": "high" if write else "low",
+                               "requires_approval": write, "steps": steps, "content": content}
+        return {"task_id": task_id, "session": self.snapshot()}
+
+    def advance(self, task_id):
+        entry = self.tasks.get(task_id)
+        if not entry or entry["status"] in {"rejected", "completed", "failed"}:
+            raise Bad("tarefa inválida")
+        step = entry["steps"][entry["steps_done"]]
+        if step["requires_approval"] and not entry["approved"]:
+            entry["status"] = "awaiting_approval"
+            raise Bad("aguardando aprovação humana")
+        if step["action"] == "preview":
+            entry["result"] = {"path": entry["path"], "diff": f"--- {entry['path']}\n+++ proposto\n+{entry['content']}"}
+            entry["status"] = "awaiting_approval"
+        elif step["action"] == "write":
+            entry["result"] = {"status": "written", "path": entry["path"]}
+            entry["status"] = "in_progress"
+        else:
+            entry["result"] = {"content": "resultado local"}
+            entry["status"] = "in_progress"
+        entry["steps_done"] += 1
+        return self.snapshot()
+
+    def approve(self, task_id):
+        entry = self.tasks.get(task_id)
+        if not entry or entry["status"] != "awaiting_approval":
+            raise Bad("tarefa não está aguardando aprovação")
+        entry.update(approved=True, status="approved")
+        return self.snapshot()
+
+    def reject(self, task_id):
+        entry = self.tasks.get(task_id)
+        if not entry or entry["status"] != "awaiting_approval":
+            raise Bad("tarefa não está aguardando aprovação")
+        entry.update(status="rejected")
+        return self.snapshot()
+
+    def validate(self, task_id, passed):
+        entry = self.tasks.get(task_id)
+        if not entry or entry["steps_done"] < len(entry["steps"]):
+            raise Bad("tarefa ainda não terminou")
+        entry.update(validated=passed, status="completed" if passed else "failed")
+        return self.snapshot()
+
+    def reset(self):
+        self.active, self.workspace, self.tasks = False, "", {}
+        return {"ok": True}
+
+
